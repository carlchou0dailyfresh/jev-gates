{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jev-gates.local/schemas/1.0/evidence-record.schema.json",
  "title": "EvidenceRecord",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "synthetic",
        "public-source",
        "user-provided"
      ]
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "retrievedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "content": {
      "type": "string"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "start",
          "end",
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "properties": {
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "validUntil": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "evidenceId",
    "sourceId",
    "kind",
    "locator",
    "retrievedAt",
    "content",
    "contentDigest",
    "citations",
    "scope",
    "freshness"
  ],
  "additionalProperties": false,
  "$comment": "Runtime additionally checks contentDigest and citation offsets/quote against the original content. Offsets count UTF-16 code units."
}
