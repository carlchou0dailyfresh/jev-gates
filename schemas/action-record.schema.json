{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jev-gates.local/schemas/1.0/action-record.schema.json",
  "title": "ActionRecord",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "operationId": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "parametersDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policyDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "pending",
        "executed",
        "verified",
        "failed"
      ]
    },
    "toolKind": {
      "enum": [
        "sandbox",
        "live"
      ]
    },
    "receipt": {},
    "queryResult": {},
    "verification": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "evidence": {}
      },
      "required": [
        "passed",
        "evidence"
      ],
      "additionalProperties": false
    },
    "executionCount": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schemaVersion",
    "operationId",
    "target",
    "parametersDigest",
    "policyDigest",
    "status",
    "toolKind"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "required": [
          "verification"
        ],
        "properties": {
          "verification": {
            "properties": {
              "passed": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
