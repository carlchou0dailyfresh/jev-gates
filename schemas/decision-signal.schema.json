{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jev-gates.local/schemas/1.0/decision-signal.schema.json",
  "title": "DecisionSignal",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "truth": {
      "enum": [
        "TRUE",
        "FALSE",
        "UNKNOWN"
      ]
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policyDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "provenance": {
      "enum": [
        "fixture",
        "recorded-live",
        "live-localjev",
        "live-typesafe",
        "deterministic"
      ]
    },
    "upstreamModel": {
      "type": "string",
      "minLength": 1
    },
    "answer": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "noul"
            },
            "noul": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "type",
            "noul"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "choice"
            },
            "choice": {
              "type": "string",
              "minLength": 1
            },
            "probabilities": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "type",
            "choice",
            "probabilities",
            "confidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "score"
            },
            "score": {
              "type": "number",
              "minimum": 0
            },
            "probabilities": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "legend": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "type",
            "score",
            "probabilities",
            "legend",
            "confidence"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "truth",
    "reasonCode",
    "inputDigest",
    "policyDigest",
    "provider",
    "model",
    "evidenceIds",
    "provenance"
  ],
  "additionalProperties": false
}
