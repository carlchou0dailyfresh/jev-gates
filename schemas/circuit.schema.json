{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jev-gates.local/schemas/1.0/circuit.schema.json",
  "title": "Circuit",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
                "not": {
                  "enum": [
                    "constructor",
                    "prototype",
                    "__proto__"
                  ]
                }
              },
              "kind": {
                "const": "constant"
              },
              "value": {
                "enum": [
                  "TRUE",
                  "FALSE",
                  "UNKNOWN"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
                "not": {
                  "enum": [
                    "constructor",
                    "prototype",
                    "__proto__"
                  ]
                }
              },
              "kind": {
                "const": "semantic"
              },
              "question": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "noul"
                      },
                      "instructions": {
                        "type": "string",
                        "minLength": 1
                      },
                      "criteria": {
                        "type": "object",
                        "properties": {
                          "true": {
                            "type": "string",
                            "minLength": 1
                          },
                          "false": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "type",
                      "instructions"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "choice"
                      },
                      "instructions": {
                        "type": "string",
                        "minLength": 1
                      },
                      "criteria": {
                        "type": "object",
                        "minProperties": 2,
                        "maxProperties": 128,
                        "additionalProperties": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    },
                    "required": [
                      "type",
                      "instructions",
                      "criteria"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "score"
                      },
                      "instructions": {
                        "type": "string",
                        "minLength": 1
                      },
                      "criteria": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 2,
                        "maxItems": 10
                      }
                    },
                    "required": [
                      "type",
                      "instructions",
                      "criteria"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "policy": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "noul"
                      },
                      "falseAt": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "trueAt": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "type",
                      "falseAt",
                      "trueAt"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "choice"
                      },
                      "trueLabels": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uniqueItems": true
                      },
                      "falseLabels": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uniqueItems": true
                      },
                      "unknownLabels": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 1,
                        "uniqueItems": true
                      },
                      "minProbability": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "minMargin": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "type",
                      "trueLabels",
                      "falseLabels",
                      "unknownLabels",
                      "minProbability",
                      "minMargin"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "score"
                      },
                      "falseAt": {
                        "type": "number",
                        "minimum": 0
                      },
                      "trueAt": {
                        "type": "number",
                        "minimum": 0
                      },
                      "minConfidence": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "type",
                      "falseAt",
                      "trueAt",
                      "minConfidence"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "input": {
                "type": "string"
              },
              "context": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "when": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
                "not": {
                  "enum": [
                    "constructor",
                    "prototype",
                    "__proto__"
                  ]
                }
              }
            },
            "required": [
              "id",
              "kind",
              "question",
              "policy"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
                "not": {
                  "enum": [
                    "constructor",
                    "prototype",
                    "__proto__"
                  ]
                }
              },
              "kind": {
                "const": "rule"
              },
              "path": {
                "type": "string"
              },
              "op": {
                "enum": [
                  "eq",
                  "neq",
                  "gt",
                  "gte",
                  "lt",
                  "lte",
                  "exists"
                ]
              },
              "value": {}
            },
            "required": [
              "id",
              "kind",
              "path",
              "op"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
                "not": {
                  "enum": [
                    "constructor",
                    "prototype",
                    "__proto__"
                  ]
                }
              },
              "kind": {
                "const": "logic"
              },
              "op": {
                "enum": [
                  "and",
                  "or",
                  "not",
                  "xor",
                  "nand",
                  "nor",
                  "kofn"
                ]
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
                  "not": {
                    "enum": [
                      "constructor",
                      "prototype",
                      "__proto__"
                    ]
                  }
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "k": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "id",
              "kind",
              "op",
              "inputs"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "maxItems": 256
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
        "not": {
          "enum": [
            "constructor",
            "prototype",
            "__proto__"
          ]
        }
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "version",
    "name",
    "nodes",
    "outputs"
  ],
  "additionalProperties": false,
  "$comment": "Runtime checks unique ids, all referenced nodes, acyclicity, pointer syntax, policy/question compatibility and exact operator arity."
}
